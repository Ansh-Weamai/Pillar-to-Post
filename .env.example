# ================================================================
# PTP360 Second-Pass QA -- environment variables (template)
# Copy to .env and fill in real values. .env is gitignored.
# ================================================================

# Required for all 3 features -- get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# gemini-3-flash-preview     -- stronger reasoning, use for Features 2 & 3
# gemini-3.1-flash-lite      -- stable, cheaper/faster, fine for Feature 1
GEMINI_MODEL=gemini-3-flash-preview
