# ================================================================
# PTP360 Second-Pass QA -- environment variables (template)
# Copy to .env and fill in real values. .env is gitignored.
# ================================================================

# One key per feature -- get from https://aistudio.google.com/app/apikey
# Tracked separately so usage/quota is attributable per feature, even though
# all three call the same model.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# gemini-3.5-flash-lite -- stable, multimodal, solid free-tier quota.
# Run `node scripts/check-gemini-models.js` (see README) to see what your
# own key currently has access to before changing this.
GEMINI_MODEL=gemini-3.5-flash-lite
